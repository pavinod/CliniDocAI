# CliniDocAI environment configuration
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit it.

# ---------------------------------------------------------------------------
# LLM / claim-support model
# ---------------------------------------------------------------------------
# The app itself picks the model in Settings → "AI model (claim check)";
# rule-based is the default there. MODEL_PROVIDER below only affects
# command-line runs (evaluate.py) and defaults to rule-based ("none") —
# no network calls, no API key required.
# The app reads this file (.env) on start; variables already exported in
# your shell take precedence.
#
# Supported providers:
#   none          rule-based only (default)
#   openrouter    OpenRouter API  (recommended)
#   openai        OpenAI API
#   lmstudio      Local LM Studio instance
#   http          Custom OpenAI-compatible endpoint

MODEL_PROVIDER=none

# ---------------------------------------------------------------------------
# OpenRouter (https://openrouter.ai)
# ---------------------------------------------------------------------------
# Your OpenRouter API key — get it at https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use for claim-support assessment.
# The model selector in the UI overrides this value at runtime.
# Model IDs change over time — check https://openrouter.ai/models.
# Available models (see UI dropdown for full list):
#
#   openrouter/free                              free tier (default)
#   deepseek/deepseek-v4-flash                   general work, long context
#   deepseek/deepseek-v4.1-flash-1017            full DeepSeek Flash
#   z-ai/glm-4.7-flash                           general work
#   z-ai/glm-flash-latest                        general work, very cheap
#   moonshotai/kimi-latest                       general work, long context
#   anthropic/claude-haiku-5.5                   Claude, long context
#   openai/gpt-5-nano                            quick tasks
#   openai/gpt-5.6-luna                          general work, long context
#   openai/gpt-5.1-codex-mini                    coding
#   google/gemini-3.1-flash-lite                 general work
#   qwen/qwen3-coder-30b-a3b-instruct            coding
#   qwen/qwen3-vl-30b-a3b-instruct               images and scans
#   mistralai/mistral-small-3.2-24b-instruct     EU provider
#   meta-llama/llama-4-scout                     very long context
#
# OPENROUTER_MODEL=openrouter/free

# Request timeout in seconds (default: 8)
# MODEL_TIMEOUT_S=8

# ---------------------------------------------------------------------------
# OpenAI (alternative provider)
# ---------------------------------------------------------------------------
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# LM Studio (local inference)
# ---------------------------------------------------------------------------
# MODEL_PROVIDER=lmstudio
# LM_STUDIO_URL=http://localhost:1234/v1
# LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_MODEL=local

# ---------------------------------------------------------------------------
# Custom OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# MODEL_PROVIDER=http
# CLINIDOC_MODEL_URL=https://your-endpoint/v1/chat/completions
# CLINIDOC_MODEL_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Data directory override (optional)
# ---------------------------------------------------------------------------
# DATA_ROOT=data/patient-0000-0001
